# Accounts and the shared database. Leave both empty to run the self-contained
# demo that keeps everything in the browser. The publishable key is meant to be
# public: row level security in the database decides what a visitor can do.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. RoomPair's local demo and bundled EN/TR languages work without these.
# Copy this file to .env.local only when connecting your own n8n instance.
# NEVER prefix any of these with NEXT_PUBLIC_.
N8N_TRANSLATION_WEBHOOK_URL=

# Match the n8n Webhook node's Header Auth credential:
# Header name: X-RoomPair-Webhook-Secret; value: a long random secret.
N8N_TRANSLATION_WEBHOOK_SECRET=

# Only needed for the optional POST /api/translations maintenance endpoint.
# Use a separate random token of at least 32 characters; the CLI does not need it.
ROOMPAIR_TRANSLATION_ADMIN_TOKEN=

# Keep your OpenAI API key in n8n's credential store, not in RoomPair.
# Select an OpenAI credential on the workflow's HTTP Request node.
