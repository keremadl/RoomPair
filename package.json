{
  "name": "roompair",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:design": "node scripts/check-design.mjs",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "translate": "node scripts/generate-locale.mjs",
    "i18n:check": "node scripts/i18n/extract.mjs --check --summary",
    "i18n:sync": "bash scripts/i18n/run-n8n.sh",
    "test:e2e": "playwright test",
    "test:accounts": "playwright test -c playwright.accounts.config.ts",
    "test:db": "supabase/tests/run-local.sh",
    "db:seed": "tsx scripts/db/generate-seed.ts",
    "format": "prettier --write src tests *.ts *.json",
    "lab": "node lab/build.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "motion": "^12.0.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.9.10",
    "supabase": "^3.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
